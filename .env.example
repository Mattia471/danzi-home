# ============================================================
# KROSS BOOKING - booking engine pubblico
# ============================================================
# Inserire l'URL reale fornito da Kross Booking per la struttura.
# true = usa il booking simulato interno per presentazioni al cliente.
# false = apre il Booking Engine Kross configurato qui sotto.
VITE_KROSS_DEMO_MODE=true
VITE_KROSS_BOOKING_URL=
VITE_KROSS_PROPERTY_ID=

# I nomi dei parametri sono configurabili perché dipendono dal link/integrazione
# assegnata da Kross Booking. Se Kross fornisce parametri diversi, basta cambiarli qui.
VITE_KROSS_CHECKIN_PARAM=checkin
VITE_KROSS_CHECKOUT_PARAM=checkout
VITE_KROSS_GUESTS_PARAM=adults
VITE_KROSS_PROPERTY_PARAM=property_id

# ============================================================
# SUPABASE - opzionale / area amministrativa legacy
# ============================================================
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Vercel serverless function /calendar.ics - legacy, non necessaria se Kross
# gestisce il Channel Manager e la sincronizzazione con Airbnb.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
PROPERTY_ID=00000000-0000-0000-0000-000000000001

# Vecchia sincronizzazione iCal - lasciare vuoto se si usa Kross come fonte unica.
AIRBNB_ICAL_URL=
OWNER_EMAIL=booking@danzihouse.it
RESEND_API_KEY=
FROM_EMAIL=D'Anzi House <booking@danzihouse.it>
