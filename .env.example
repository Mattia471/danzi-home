# ============================================================
# KROSS BOOKING
# ============================================================
# true  = booking simulato interno
# false = handoff al Booking Engine Kross
VITE_KROSS_DEMO_MODE=true

# Compilare quando Kross fornisce i dati reali.
VITE_KROSS_BOOKING_URL=
VITE_KROSS_PROPERTY_ID=

# Nomi query parameter configurabili.
VITE_KROSS_CHECKIN_PARAM=checkin
VITE_KROSS_CHECKOUT_PARAM=checkout
VITE_KROSS_GUESTS_PARAM=adults
VITE_KROSS_PROPERTY_PARAM=property_id

# ============================================================
# SUPABASE - LEGACY / OPZIONALE
# ============================================================
# Valori client. Le variabili VITE_* sono pubbliche nel bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo server-side / Vercel legacy. NON usare prefisso VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PROPERTY_ID=00000000-0000-0000-0000-000000000001

# Vecchia sincronizzazione iCal. Lasciare vuoto con Kross attivo.
AIRBNB_ICAL_URL=

# Notifiche legacy/opzionali.
OWNER_EMAIL=
RESEND_API_KEY=
FROM_EMAIL=
